{
  "cases": [
    {
      "id": "create_skill_package",
      "prompt": "把这个流程整理成一个可复用的 skill",
      "baseline_output": "好的，我可以帮你把这个流程整理成一份文档，建议先列出步骤……",
      "with_skill_output": "已创建 hugailab 风格 skill 包：SKILL.md、manifest.json、agents/interface.yaml、evals/trigger_cases.json 与 reports/skill-ir.json。",
      "assertions": [
        {
          "kind": "file_exists",
          "path": "SKILL.md"
        },
        {
          "kind": "contains",
          "path": "SKILL.md",
          "needle": "name: hugailab-meta-skill"
        },
        {
          "kind": "contains",
          "path": "SKILL.md",
          "needle": "## Router Rules"
        },
        {
          "kind": "contains",
          "path": "manifest.json",
          "needle": "\"version\""
        },
        {
          "kind": "not_contains",
          "path": "README.md",
          "needle": "sk-"
        }
      ],
      "human_notes": "真实使用时还应人工确认 description 的触发边界与产出结构。"
    },
    {
      "id": "audit_only",
      "prompt": "审计这个 skill 的路由与输出评估，只给建议，先不要改文件",
      "baseline_output": "我看了看，整体还行，建议优化一下描述。",
      "with_skill_output": "只读审计：运行 validate_skill.py 与 trigger_eval.py，输出 failures/warnings 清单，不修改任何文件。",
      "assertions": [
        {
          "kind": "file_exists",
          "path": "reports/skill-ir.json"
        },
        {
          "kind": "contains",
          "path": "reports/skill-ir.json",
          "needle": "evidence_boundary"
        },
        {
          "kind": "contains",
          "path": "reports/trigger-eval.json",
          "needle": "\"ok\": true"
        },
        {
          "kind": "not_contains",
          "path": "README.md",
          "needle": "BEGIN PRIVATE KEY"
        }
      ],
      "human_notes": "审计型请求应验证未产生文件改动；当前以只读断言近似。"
    },
    {
      "id": "self_llm_judge_evidence",
      "prompt": "用 hugailab-meta-skill 交付可验证的 skill",
      "baseline_output": "我帮你写一个提示词。",
      "with_skill_output": "生成 skill 包并跑 validate/trigger/output eval，证据写 reports/。",
      "assertions": [
        {
          "kind": "file_exists",
          "path": "scripts/output_eval.py"
        },
        {
          "kind": "contains",
          "path": "scripts/output_eval.py",
          "needle": "--retries"
        },
        {
          "kind": "contains",
          "path": "references/output-eval-method.md",
          "needle": "llm_judge 断言写法"
        },
        {
          "kind": "contains",
          "path": "scripts/new_skill.py",
          "needle": "BRAND_PREFIX = \"hugailab\""
        },
        {
          "kind": "contains",
          "path": "scripts/publish_skill.py",
          "needle": "wait_for_pr_checks"
        },
        {
          "kind": "contains",
          "path": "scripts/validate_skill.py",
          "needle": "scan_dangerous_patterns"
        },
        {
          "kind": "contains",
          "path": "scripts/release_check.py",
          "needle": "skill_pattern_scan"
        },
        {
          "kind": "contains",
          "path": "scripts/score_skill.py",
          "needle": "score_trigger"
        },
        {
          "kind": "contains",
          "path": "scripts/new_skill.py",
          "needle": "score_skill.py"
        },
        {
          "kind": "contains",
          "path": "scripts/score_skill.py",
          "needle": "--label"
        },
        {
          "kind": "contains",
          "path": "scripts/release_check.py",
          "needle": "scorecard_freshness"
        },
        {
          "kind": "llm_judge",
          "prompt": "hugailab-meta-skill 的 output_eval.py 是否支持 llm_judge 网络重试参数 --retries 与 --retry-backoff，并在 fixture 模式统计 assertions_skipped？只回答 yes 或 no。",
          "must": "yes"
        },
        {
          "kind": "llm_judge",
          "prompt": "references/output-eval-method.md 是否包含 llm_judge 断言写法一节，且建议自包含提示词、避免逐字比对式表述？只回答 yes 或 no。",
          "must": "yes"
        },
        {
          "kind": "llm_judge",
          "prompt": "new_skill.py 是否默认把新 skill 名规范化为 hugailab- 前缀（BRAND_PREFIX）且前缀后最多 5 段？只回答 yes 或 no。",
          "must": "yes"
        },
        {
          "kind": "llm_judge",
          "prompt": "hugailab-meta-skill 是否同时具备 PR 后自动等待状态检查、validate 内置危险模式扫描、release_check 含 skill_pattern_scan 门禁这三项能力？只回答一个词 yes 或 no。",
          "must": "yes"
        },
        {
          "kind": "llm_judge",
          "prompt": "score_skill.py 是否为证据绑定评分器（六维加权、只读 reports、缺失证据降分），并且 new_skill.py 在 production 模式下自动生成 scorecard.json？只回答一个词 yes 或 no。",
          "must": "yes"
        },
        {
          "kind": "llm_judge",
          "prompt": "脚手架评分是否标记为初始快照（--label initial）并在评分卡上提示重新评分？release_check 是否包含 scorecard_freshness 新鲜度门禁？只回答一个词 yes 或 no。",
          "must": "yes"
        }
      ],
      "human_notes": "v3.6.1 自证：评分器生命周期修复 + 既有能力以 provider-backed 证据落地。"
    }
  ]
}
